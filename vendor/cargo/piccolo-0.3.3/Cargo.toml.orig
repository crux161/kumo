[workspace]
resolver = "2"
members = [
    "util",
]
default-members = [
    ".",
    "util",
]

[workspace.package]
version = "0.3.3"
edition = "2021"
authors = ["kyren <catherine@kyju.org>"]
license = "MIT"
repository = "https://github.com/kyren/piccolo"

[workspace.dependencies]
ahash = "0.8"
allocator-api2 = "0.2"
anyhow = "1.0"
gc-arena = { version = "0.5.3", features = ["allocator-api2", "hashbrown"] }
hashbrown = { version = "0.14", features = ["raw"] }
rand = { version = "0.8", features = ["small_rng"] }
serde = "1.0"
thiserror = "1.0"

piccolo = { path = "./", version = "0.3.3" }

[package]
name = "piccolo"
description = "Stackless Lua VM implemented in pure Rust"
readme = "README.md"
version.workspace = true
edition.workspace = true
authors.workspace = true
license.workspace = true
repository.workspace = true

[features]
default = ["std"]
std = [
    "ahash/std",
    "allocator-api2/std",
    "anyhow/std",
    "gc-arena/std",
    "rand/std",
    "rand/std_rng",
    "thiserror/std",
]

[dependencies]
ahash = { workspace = true, default-features = false, features = ["no-rng"] }
allocator-api2 = { workspace = true, default-features = false, features = ["alloc"] }
anyhow = { workspace = true, default-features = false }
gc-arena = { workspace = true, default-features = false }
hashbrown = { workspace = true, default-features = false, features = ["ahash", "raw"] }
libm = { version = "0.2.16", default-features = false }
rand = { workspace = true, default-features = false }
thiserror = { path = "../thiserror-1.0.69", version = "1.0", default-features = false }

[dev-dependencies]
clap = { version = "4.5", features = ["cargo"] }
rustyline = "14.0"
