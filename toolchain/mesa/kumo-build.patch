+static int
+csf_native_wait_snapshot(struct panfrost_device *dev, uint64_t snapshot)
+{
+   struct kumo_gpu_native_reply reply;
+   /* One bounded wait, then observe the completed fence again. A wake is not itself
+    * completion. Any uncertainty closes the session before caller cleanup. — KESTREL */
+   for (unsigned attempt = 0; attempt < 2; ++attempt) {
+      if (csf_native_call(dev, KUMO_NATIVE_ARM, snapshot, 0, &reply))
+         break;
+      if (reply.state == KUMO_NATIVE_COMPLETE && !reply.gpu_status) {
+         if (!csf_native_call(dev, KUMO_NATIVE_DROP, snapshot, 0, &reply))
+            return 0;
+         break;
+      }
+      if (reply.state != KUMO_NATIVE_AVAILABLE || !reply.id)
+         break;
+      uint64_t wake = reply.id;
+      if (attempt || csf_native_call(dev, KUMO_NATIVE_WAIT, wake,
+                                    KUMO_NATIVE_MAX_TIMEOUT_NS, &reply) ||
+          reply.state != KUMO_NATIVE_WOKEN)
+         break;
+   }
+   pan_kmod_kumo_dev_lost(dev->kmod.dev);
+   return -1;
+}
