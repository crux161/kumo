+/* SPDX-License-Identifier: MIT */
+
+/* KUMO (VK2-c): binary vk_syncs over G7p's native binaries. A wait snapshots the payload and
+ * arms it, so completion is only ever ARM's COMPLETE. Every native refusal of a well-formed
+ * request on a live object is session loss, except a full object table, which is
+ * out-of-memory. */
+
+#include "panvk_kumo_sync.h"
+
+#include "kumo_kmod.h"
+#include "panvk_physical_device.h"
+
+#include "util/os_time.h"
+#include "vk_device.h"
+#include "vk_log.h"
+
+static struct pan_kmod_dev *
+kmod_dev(struct vk_device *device)
+{
+   return to_panvk_physical_device(device->physical)->kmod.dev;
+}
+
+static struct panvk_kumo_sync *
+to_kumo_sync(struct vk_sync *sync)
+{
+   assert(vk_sync_is_panvk_kumo_sync(sync));
+   return container_of(sync, struct panvk_kumo_sync, base);
+}
+
+static VkResult
+lost(struct vk_device *device, const char *operation)
+{
+   pan_kmod_kumo_dev_lost(kmod_dev(device));
+   return vk_device_set_lost(device, "KUMO native %s failed", operation);
+}
+
+static VkResult
+native(struct vk_device *device, uint32_t operation, uint64_t id, uint64_t value,
+       const char *name, struct kumo_gpu_native_reply *reply)
+{
+   const struct kumo_gpu_native_request request = {
+      .operation = operation,
+      .id = id,
+      .value = value,
+   };
+
+   if (pan_kmod_kumo_native(kmod_dev(device), &request, reply) != KUMO_GPU_OK)
+      return lost(device, name);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+kumo_sync_init(struct vk_device *device, struct vk_sync *sync,
+               uint64_t initial_value)
+{
+   struct panvk_kumo_sync *kumo = to_kumo_sync(sync);
+   struct kumo_gpu_native_reply reply;
+
+   assert(!(sync->flags & VK_SYNC_IS_TIMELINE) && initial_value <= 1);
+
+   const struct kumo_gpu_native_request request = {
+      .operation = KUMO_NATIVE_CREATE_BINARY,
+      .value = initial_value != 0,
+   };
+   const uint32_t status =
+      pan_kmod_kumo_native(kmod_dev(device), &request, &reply);
+
+   /* The session's native tables are full: nothing was created or lost. */
+   if (status == KUMO_GPU_NO_MEMORY)
+      return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+   if (status != KUMO_GPU_OK || !reply.id)
+      return lost(device, "CREATE_BINARY");
+
+   kumo->id = reply.id;
+   return VK_SUCCESS;
+}
+
+static void
+kumo_sync_finish(struct vk_device *device, struct vk_sync *sync)
+{
+   /* A refused DROP loses the device inside the helper. */
+   pan_kmod_kumo_sync_destroy(kmod_dev(device), to_kumo_sync(sync)->id);
+}
+
+static VkResult
+kumo_sync_signal(struct vk_device *device, struct vk_sync *sync,
+                 uint64_t value)
+{
+   struct kumo_gpu_native_reply reply;
+
+   assert(value == 0);
+   return native(device, KUMO_NATIVE_SIGNAL, to_kumo_sync(sync)->id, 0,
+                 "SIGNAL", &reply);
+}
+
+static VkResult
+kumo_sync_reset(struct vk_device *device, struct vk_sync *sync)
+{
+   struct kumo_gpu_native_reply reply;
+
+   return native(device, KUMO_NATIVE_RESET, to_kumo_sync(sync)->id, 0,
+                 "RESET", &reply);
+}
+
+/* dst takes src's native object, payload and all. src keeps dst's old object, reset. */
+static VkResult
+kumo_sync_move(struct vk_device *device, struct vk_sync *dst,
+               struct vk_sync *src)
+{
+   struct panvk_kumo_sync *to = to_kumo_sync(dst), *from = to_kumo_sync(src);
+   const uint64_t old = to->id;
+
+   to->id = from->id;
+   from->id = old;
+   return kumo_sync_reset(device, src);
+}
+
+static VkResult
+kumo_sync_wait(struct vk_device *device, struct vk_sync *sync,
+               uint64_t wait_value, enum vk_sync_wait_flags wait_flags,
+               uint64_t abs_timeout_ns)
+{
+   const uint64_t id = to_kumo_sync(sync)->id;
+   struct kumo_gpu_native_reply reply;
+   VkResult result;
+
+   assert(wait_value == 0 && !(wait_flags & VK_SYNC_WAIT_ANY));
+
+   /* Nothing can submit or signal while this runs, since every native call is serial in
+    * the one session owner. So a payload that is absent now stays absent until the
+    * deadline, and the wait times out at once instead of sleeping until it does. */
+   if (wait_flags & VK_SYNC_WAIT_PENDING) {
+      result = native(device, KUMO_NATIVE_PENDING, id, 0, "PENDING", &reply);
+      if (result != VK_SUCCESS)
+         return result;
+      return reply.state == KUMO_NATIVE_AVAILABLE ? VK_SUCCESS : VK_TIMEOUT;
+   }
+
+   result = native(device, KUMO_NATIVE_SNAPSHOT, id, 0, "SNAPSHOT", &reply);
+   if (result != VK_SUCCESS)
+      return result;
+   if (reply.state != KUMO_NATIVE_AVAILABLE || !reply.id)
+      return VK_TIMEOUT;
+
+   const uint64_t snapshot = reply.id;
+   int64_t timeout_ns = -1;
+   if (abs_timeout_ns != UINT64_MAX) {
+      const uint64_t now = (uint64_t)os_time_get_nano();
+      timeout_ns = abs_timeout_ns > now
+                      ? (int64_t)MIN2(abs_timeout_ns - now, (uint64_t)INT64_MAX)
+                      : 0;
+   }
+
+   /* 1 complete, 0 timed out, -1 the helper has already lost the device. */
+   const int complete =
+      pan_kmod_kumo_snapshot_wait(kmod_dev(device), snapshot, timeout_ns);
+   if (complete < 0)
+      return vk_device_set_lost(device, "KUMO native wait failed");
+
+   result = native(device, KUMO_NATIVE_DROP, snapshot, 0, "DROP", &reply);
+   if (result != VK_SUCCESS)
+      return result;
+
+   return complete ? VK_SUCCESS : VK_TIMEOUT;
+}
+
+const struct vk_sync_type panvk_kumo_sync_type = {
+   .size = sizeof(struct panvk_kumo_sync),
+   /* GPU_MULTI_WAIT: each PREPARE captures its own snapshot of the payload. */
+   .features = VK_SYNC_FEATURE_BINARY | VK_SYNC_FEATURE_GPU_WAIT |
+               VK_SYNC_FEATURE_GPU_MULTI_WAIT | VK_SYNC_FEATURE_CPU_WAIT |
+               VK_SYNC_FEATURE_CPU_RESET | VK_SYNC_FEATURE_CPU_SIGNAL |
+               VK_SYNC_FEATURE_WAIT_PENDING,
+   .init = kumo_sync_init,
+   .finish = kumo_sync_finish,
+   .signal = kumo_sync_signal,
+   .reset = kumo_sync_reset,
+   .move = kumo_sync_move,
+   .wait = kumo_sync_wait,
+};
