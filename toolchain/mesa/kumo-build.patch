+   return -1;
+}
+
+static int
+csf_native_submit_init(struct panfrost_context *ctx, uint64_t va, uint32_t bytes)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   const struct kumo_gpu_native_point signal = {ctx->native_syncobj, 0};
+   const struct kumo_gpu_native_request prepare = {
+      .operation = KUMO_NATIVE_PREPARE, .id = ctx->csf.native_group,
+      .job = {pan_kmod_vm_handle(dev->kmod.vm), bytes, va, 1},
+      .signals = &signal, .signal_count = 1,
+   };
+   struct kumo_gpu_native_reply reply;
+   if (pan_kmod_kumo_native(dev->kmod.dev, &prepare, &reply) != KUMO_GPU_OK || !reply.id)
+      goto failed;
+   uint64_t job = reply.id;
+   if (csf_native_call(dev, KUMO_NATIVE_STEP, job, 0, &reply) ||
+       reply.state != KUMO_NATIVE_SUBMITTED || !reply.id)
+      goto failed;
+   uint64_t snapshot = reply.id;
+   if (csf_native_call(dev, KUMO_NATIVE_DROP, job, 0, &reply))
+      goto failed;
+   return csf_native_wait_snapshot(dev, snapshot);
+failed:
+   pan_kmod_kumo_dev_lost(dev->kmod.dev);
+   return -1;
+}
