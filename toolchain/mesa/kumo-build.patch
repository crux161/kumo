@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: MIT */
+
+/* KUMO (VK2-c): panvk's vk_sync type over the native session's binary syncs. */
+
+#ifndef PANVK_KUMO_SYNC_H
+#define PANVK_KUMO_SYNC_H
+
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "util/macros.h"
+#include "vk_sync.h"
+
+/* One KUMO_NATIVE_CREATE_BINARY object. Its payload is signaled, a submitted GPU signal, or
+ * nothing. Timelines are the runtime's vk_sync_timeline over this type, as panvk uses before
+ * v10, so submission is DEFERRED and never needs a submit thread. Every call goes through
+ * the session's one serial native owner, so one thread drives the device. */
+struct panvk_kumo_sync {
+   struct vk_sync base;
+   uint64_t id;
+};
+
+extern const struct vk_sync_type panvk_kumo_sync_type;
+
+static inline bool
+vk_sync_is_panvk_kumo_sync(const struct vk_sync *sync)
+{
+   return sync->type == &panvk_kumo_sync_type;
+}
+
+/* The native ID a PREPARE's waits and signals name, at value 0. */
+static inline uint64_t
+panvk_kumo_sync_id(struct vk_sync *sync)
+{
+   assert(vk_sync_is_panvk_kumo_sync(sync));
+   return container_of(sync, struct panvk_kumo_sync, base)->id;
+}
+
+#endif
